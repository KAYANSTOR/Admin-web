rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isSignedIn(); // إلى حين إضافة دور مخصص للأدمن عبر Custom Claims
    }
    match /networks/{userId}/sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update, delete: if false; // المبيعات لا تُعدَّل بعد إنشائها
    }
    match /app_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // يُفضَّل لاحقاً تقييدها بـ Custom Claim الخاص بالأدمن فقط
    }
  }
}
