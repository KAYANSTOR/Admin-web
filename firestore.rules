rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    
    // We use get() to read the user's role from the users collection
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == '773303455@kayansoft.com';
    }
    
    function isStaff() {
      return isSignedIn() && !isAdmin() && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'STAFF';
    }
    
    function hasPermission(perm) {
      return isStaff() && (perm in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.permissions);
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // القراءة محصورة بالمالك، أو الإدارة، أو الموظف
      allow read: if isOwner(userId) || isAdmin() || hasPermission('clients') || hasPermission('employees');
      
      // السماح للعميل بإنشاء حسابه بنفسه (Self-Registration) بشرط أن يكون دوره NETWORK_OWNER وحسابه غير فعال
      allow create: if isAdmin()
                    || (hasPermission('clients') && request.resource.data.role == 'NETWORK_OWNER')
                    || (isOwner(userId)
                        && request.resource.data.role == 'NETWORK_OWNER'
                        && request.resource.data.is_active == false);
      
      // السماح بالتعديل/الحذف للإدارة فقط
      allow update, delete: if isAdmin() || hasPermission('clients');
    }
    
    match /employees/{employeeId} {
      allow read: if isOwner(employeeId) || isAdmin() || hasPermission('employees');
      allow create: if isAdmin() || hasPermission('employees');
      allow update: if isAdmin() || isOwner(employeeId);
      allow delete: if isAdmin() || hasPermission('employees');
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId) || isAdmin() || hasPermission('notifications');
      allow create, update, delete: if isAdmin() || hasPermission('notifications');
    }

    match /networks/{userId}/{document=**} {
      allow read: if isAdmin() || hasPermission('clients') || hasPermission('sales') || isOwner(userId);
      allow write: if isOwner(userId) || isAdmin() || hasPermission('clients');
    }

    match /app_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('settings');
    }
    
    match /app_settings/global_config/notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('notifications');
    }
  }
}
