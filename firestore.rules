rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    
    // We use get() to read the user's role from the users collection
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }
    
    function isStaff() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'STAFF';
    }
    
    function hasPermission(perm) {
      return isStaff() && (perm in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions);
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // القراءة محصورة بالمالك، أو الإدارة، أو الموظف
      allow read: if isOwner(userId) || isAdmin() || hasPermission('clients') || hasPermission('employees');
      
      // السماح للعميل بإنشاء حسابه بنفسه (Self-Registration) بشرط أن يكون دوره NETWORK_OWNER وحسابه غير فعال
      allow create: if isOwner(userId) 
                    && request.resource.data.role == 'NETWORK_OWNER' 
                    && request.resource.data.is_active == false;
      
      // السماح بالتعديل/الحذف للإدارة فقط
      allow update, delete: if isAdmin() || hasPermission('clients') || hasPermission('employees');
    }
    
    match /networks/{userId}/{document=**} {
      allow read: if isAdmin() || hasPermission('clients') || hasPermission('sales') || isOwner(userId);
      allow write: if isOwner(userId);
    }

    match /app_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('settings');
    }
    
    match /app_settings/global_config/notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('notifications');
    }
  }
}
